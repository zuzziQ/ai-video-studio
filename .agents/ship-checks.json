{
  "checks": [
    {
      "id": "rag",
      "cmd": ["node", ".rag/sync.js", "--check"],
      "when": ["**"],
      "fix": "đọc lại luật bị đổi, sửa .rag/data.js nếu cần, rồi node .rag/sync.js --pin"
    },
    {
      "id": "studio-tokens",
      "cmd": ["node", "scripts/check_studio_tokens.mjs"],
      "when": ["studio/**", "scripts/check_studio_tokens.mjs", "scripts/studio_tokens_baseline.json"],
      "fix": "dùng token của studio/theme/tokens.css và lớp ui- thay cho màu viết cứng / style=\"\"; giảm mốc bằng --write"
    },
    {
      "id": "unittest",
      "cmd": ["python", "-m", "unittest", "discover", "-s", "scripts/tests"],
      "when": ["scripts/**/*.py"],
      "timeout": 120,
      "fix": "python -m unittest discover -s scripts/tests -v"
    },
    {
      "id": "nodetest",
      "cmd": ["node", "--test", "scripts/tests/queue.test.mjs", "scripts/tests/queue_telegram.test.mjs", "scripts/tests/server_paths.test.mjs", "scripts/tests/studio_security.test.mjs", "scripts/tests/publish.test.mjs", "scripts/tests/products.test.mjs", "scripts/tests/script_gate.test.mjs", "scripts/tests/qa_inputs.test.mjs", "scripts/tests/qa_low.test.mjs"],
      "when": ["scripts/**/*.mjs", "studio/**"],
      "timeout": 180,
      "fix": "node --test scripts/tests/*.test.mjs"
    }
  ]
}
